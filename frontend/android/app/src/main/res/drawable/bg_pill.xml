<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy raised pill badge (Goal: kcal, etc.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow underneath the pill -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#18000000" />
        </shape>
    </item>
    
    <!-- Main pill body - frosted glass -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#60FFFFFF" />
            <stroke android:width="1dp" android:color="#90FFFFFF" />
        </shape>
    </item>
    
    <!-- Top highlight gloss -->
    <item android:bottom="2dp" android:left="4dp" android:right="4dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
