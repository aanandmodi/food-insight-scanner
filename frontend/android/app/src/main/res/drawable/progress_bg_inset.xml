<?xml version="1.0" encoding="utf-8"?>
<!-- Deeply inset progress bar track - looks recessed into glass -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer dark border (inset illusion) -->
    <item>
        <shape>
            <corners android:radius="6dp"/>
            <solid android:color="#30000000"/>
        </shape>
    </item>
    
    <!-- Inner lighter fill (bottom of the groove) -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="5dp"/>
            <solid android:color="#20000000"/>
        </shape>
    </item>
    
    <!-- Bottom highlight (light coming from below the groove) -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
        <shape>
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#30FFFFFF"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
