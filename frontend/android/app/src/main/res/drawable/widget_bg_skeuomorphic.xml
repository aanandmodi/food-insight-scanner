<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Soft Shadow Layers to simulate blur/floating -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="6dp">
        <shape><corners android:radius="24dp"/><solid android:color="#08000000"/></shape>
    </item>
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape><corners android:radius="24dp"/><solid android:color="#08000000"/></shape>
    </item>
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="2dp">
        <shape><corners android:radius="24dp"/><solid android:color="#08000000"/></shape>
    </item>
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="0dp">
        <shape><corners android:radius="24dp"/><solid android:color="#08000000"/></shape>
    </item>
    
    <!-- Liquid Glass / Floating Background -->
    <item android:bottom="10dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <!-- 92% opaque soft cream/white to look like liquid glass -->
            <solid android:color="#EBF8F6F0" />
            <!-- Inner white highlight on the top edge to look like glass reflection -->
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
