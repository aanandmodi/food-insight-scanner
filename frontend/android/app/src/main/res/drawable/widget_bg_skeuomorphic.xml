<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Soft Shadow Layers -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="8dp">
        <shape><corners android:radius="24dp"/><solid android:color="#0A000000"/></shape>
    </item>
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape><corners android:radius="24dp"/><solid android:color="#0A000000"/></shape>
    </item>
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="0dp">
        <shape><corners android:radius="24dp"/><solid android:color="#0A000000"/></shape>
    </item>
    
    <!-- Transparent Liquid Glass Background -->
    <item android:bottom="12dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <!-- 70% transparent white/cream for true floating liquid glass -->
            <solid android:color="#B3FFFFFF" />
            <!-- Soft inner highlight -->
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
