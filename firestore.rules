rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletionGuards/$(userId));
    }

    // User profile document & all nested subcollections (/users/{userId}/...)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{collection}/{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && collection != 'aiUsage';
      }
    }

    // Canonical products are written only by the Admin SDK.
    match /config/featureFlags {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Backwards-compatible legacy user collections
    match /scan_history/{userId}/scans/{scanId} {
      allow read, write: if isOwner(userId);
    }
    match /diet_log/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }
    match /shopping_list/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }
    match /activity_logs/{userId}/logs/{logId} {
      allow read, write: if isOwner(userId);
    }
  }
}
